index 0000000..0997efc
--- /dev/null
+++ b/kernels/src/packed-centered.clh
@@ -0,0 +1,72 @@
+// Exact radix-b CRT for eight or nine 31-bit fields, four base-b digits per word.
+// Each warp owns 29 words and loads three predecessors for the negacyclic carry.
+INLINE long pg_floor_base(long value) {
+    // Translate to an unsigned multiple of b to use one constant unsigned division.
+    const ulong quotient_offset = (1ul << 63) / (ulong)PG_BASE;
+    const ulong offset = quotient_offset * (ulong)PG_BASE;
+    return as_long((as_ulong(value) + offset) / (ulong)PG_BASE - quotient_offset);
+}
+
+INLINE int pg_digit_carry(int value, int centered_top) {
+    const int shifted = value + (centered_top ? PG_BASE / 2 : 0);
+    const int quotient = shifted / (int)PG_BASE;
+    return quotient - (shifted - quotient * (int)PG_BASE < 0);
+}
+
+INLINE uint pg_from_digits(int d0, int d1, int d2, int d3, uint field) {
+    const uint p = pg_cp.p[field], q = pg_codec_bq[field];
+    uint value = (uint)(d3 < 0 ? (long)d3 + p : d3);
+    value = addmod(pg_shoup(value, PG_BASE, q, p), (uint)d2, p);
+    value = addmod(pg_shoup(value, PG_BASE, q, p), (uint)d1, p);
+    uint low = (uint)(d0 < 0 ? (long)d0 + p : d0);
+    return addmod(pg_shoup(value, PG_BASE, q, p), low, p);
+}
+
+INLINE void pg_convert(__global const uint *in, __global uint *out, const int dup, const uint tid) {
+    const int lane = tid & 31;
+    const int j = (int)(tid >> 5) * 29 + lane - 3;
+    const uint src = (uint)j & (N_SZ - 1);
+    int t[PG_K];
+    long sum = 0;
+#pragma unroll
+    for (int f = 0; f < PG_K; ++f) {
+        const uint p = pg_cp.p[f];
+        const uint v = pg_shoup(in[f * N_SZ + src], pg_cp.scale[dup][f], pg_cp.scaleq[dup][f], p);
+        t[f] = v > p / 2 ? as_int(v - p) : (int)v;
+        sum += t[f];
+    }
+    const int rank = (int)((sum + (1l << 30)) >> 31);
+    int digit[8];
+    long carry = 0;
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        long z = carry - (long)rank * pg_radix_p[k];
+#pragma unroll
+        for (int f = 0; f < PG_K; ++f)
+            z += (long)t[f] * pg_radix_h[k][f];
+        carry = pg_floor_base(z + ((k & 3) == 3 ? PG_BASE / 2 : 0));
+        digit[k] = as_int((uint)z - (uint)carry * PG_BASE);
+    }
+    // The true coefficient above b^8 is small. Recover its signed value modulo 2^32.
+    uint high = (uint)carry - (uint)rank * pg_radix_p_high;
+#pragma unroll
+    for (int f = 0; f < PG_K; ++f)
+        high += (uint)t[f] * pg_radix_h_high[f];
+    int local_carry = as_int(pg_up(high, 2));
+    if (src < 2) local_carry = -local_carry;
+    int r[4];
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const int preceding = as_int(pg_up(as_uint(digit[4 + k]), 1));
+        const int z = digit[k] + (src == 0 ? -preceding : preceding) + local_carry;
+        local_carry = pg_digit_carry(z, k == 3);
+        r[k] = z - local_carry * (int)PG_BASE;
+    }
+    const int preceding_carry = as_int(pg_up(as_uint(local_carry), 1));
+    r[0] += src == 0 ? -preceding_carry : preceding_carry;
+    if (lane >= 3 && j < N_SZ) {
+#pragma unroll
+        for (int f = 0; f < PG_K; ++f)
+            out[f * N_SZ + j] = pg_from_digits(r[0], r[1], r[2], r[3], f);
+    }
+}
