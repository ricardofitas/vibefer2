+// Q44 weights approximate a carry decision only. Every modular update is exact.
+// The admission check proves that the resulting redundant digit fits 0.51 b^4.
+INLINE long pg_weight(int t, int2 weight) {
+    // weight.s0 * 2^32 + weight.s1 = nearest(2^44 * coefficient / b^4).
+    return (long)t * weight.s0 + mul_hi(t, weight.s1);
+}
+INLINE uint pg_small_mod(long x, uint p) {
+    // p is just below 2^31; |x| < 2^34 from the input and carry bounds.
+    long y = (long)((uint)x & 0x7fffffffu) + (x >> 31) * (long)(0x80000000u - p);
+    if (y < 0) y += p;
+    if (y >= p) y -= p;
+    return (uint)y;
+}
+INLINE void pg_convert(__global const uint *in, __global uint *out, const int dup, const uint tid) {
+    const int lane = tid & 31, j = (int)(tid >> 5) * 30 + lane - 2;
+    const uint src = (uint)j & (N_SZ - 1);
+    int t[PG_K];
+    long total = 0;
+#pragma unroll
+    for (int f = 0; f < PG_K; ++f) {
+        const uint p = pg_cp.p[f];
+        const uint v = pg_shoup(in[f * N_SZ + src], pg_cp.scale[dup][f], pg_cp.scaleq[dup][f], p);
+        t[f] = v > p/2 ? as_int(v - p) : (int)v;
+        total += t[f];
+    }
+    const int m = (int)((total + (1l << 30)) >> 31);
+    long low = pg_weight(-m, pg_q44_p[0]), mid = pg_weight(-m, pg_q44_p[1]);
+    uint high = (uint)(-m) * pg_radix_p_high;
+#pragma unroll
+    for (int f = 0; f < PG_K; ++f) {
+        low += pg_weight(t[f], pg_q44_h0[f]);
+        mid += pg_weight(t[f], pg_q44_h1[f]);
+        high += (uint)t[f] * pg_radix_h_high[f];
+    }
+    const long q0 = (low + 2048) >> 12, q1 = (mid + 2048) >> 12;
+    const int T = as_int(high + (uint)q1);
+    const int low_fraction = (int)(((uint)low + 2048u) & 4095u) - 2048;
+    const int mid_fraction = (int)(((uint)mid + 2048u) & 4095u) - 2048;
+    const int prev_fraction = as_int(pg_up(as_uint(mid_fraction), 1));
+    const int rebase = (low_fraction + (src == 0 ? -prev_fraction : prev_fraction) + 2048) >> 12;
+    const int prev_rebase = as_int(pg_up(as_uint(rebase), 1)), prev_T = as_int(pg_up(as_uint(T), 2));
+    const int small = (src == 0 ? -prev_rebase : prev_rebase) + (src < 2 ? -prev_T : prev_T);
+#pragma unroll
+    for (int f = 0; f < PG_K; ++f) {
+        const uint p = pg_cp.p[f], B = pg_cp.b[f], Bq = pg_cp.bq[f];
+        long dot = -(long)m * pg_q44_pm[f];
+#pragma unroll
+        for (int k = 0; k < 5; ++k)
+            dot += (long)t[k] * pg_q44_matrix[f][k];
+        uint first = 0;
+        if (pg_q44_split[f]) {
+            first = pg_redc(dot, p, pg_cp.pinv[f]);
+            dot = 0;
+        }
+#pragma unroll
+        for (int k = 5; k < PG_K; ++k)
+            dot += (long)t[k] * pg_q44_matrix[f][k];
+        const uint A0 = addmod(first, pg_redc(dot, p, pg_cp.pinv[f]), p);
+        const uint u = submod(A0, pg_shoup(pg_small_mod(q0, p), B, Bq, p), p);
+        const uint raw = in[f * N_SZ + src], c0 = raw >= p ? raw - p : raw;
+        const uint c = dup ? addmod(c0, c0, p) : c0;
+        const uint v0 = pg_shoup(submod(c, u, p), pg_cp.binv[f], pg_cp.binvq[f], p);
+        const uint v = submod(v0, pg_shoup(T < 0 ? as_uint(T) + p : (uint)T, B, Bq, p), p);
+        const long prev_v = pg_up(v, 1);
+        const uint u_adjusted = rebase > 0 ? submod(u, B, p) : rebase < 0 ? addmod(u, B, p) : u;
+        const uint word = pg_canon((long)u_adjusted + (src == 0 ? -prev_v : prev_v) + small, p);
+        if (lane >= 2 && j < N_SZ) out[f * N_SZ + j] = word;
+    }
+}
