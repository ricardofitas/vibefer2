diff --git a/kernels/src/packed-centered-encode.clh b/kernels/src/packed-centered-encode.clh
new file mode 100644
index 0000000..f91388e
--- /dev/null
+++ b/kernels/src/packed-centered-encode.clh
@@ -0,0 +1,25 @@
+// Ordinary checkpoints may contain signed digits up to b+2. Recenter on import
+// so the first square obeys exactly the same bound as all subsequent squares.
+INLINE int pg_normalize_input(__global const int *digits, uint word, __private int *out,
+                              __global uint *error) {
+    int carry = 0;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const int d = digits[4 * word + k];
+        if (d < -(int)(PG_BASE + 2) || d > (int)(PG_BASE + 2))
+            atomic_or(error, 16u);
+        const int z = d + carry;
+        carry = pg_digit_carry(z, k == 3);
+        out[k] = z - carry * (int)PG_BASE;
+    }
+    return carry;
+}
+__kernel void packed_encode(__global const int *digits, __global uint *state,
+                            __global uint *error) {
+    const uint idx = get_global_id(0), field = idx / N_SZ, j = idx % N_SZ;
+    int r[4], previous[4];
+    pg_normalize_input(digits, j, r, error);
+    const int q = pg_normalize_input(digits, (j - 1) & (N_SZ - 1), previous, error);
+    r[0] += j == 0 ? -q : q;
+    state[idx] = pg_from_digits(r[0], r[1], r[2], r[3], field);
+}
