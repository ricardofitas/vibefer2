+// The centered converter uses exact radix-b digits, without the approximate
+// matrix quantizers. Bound the rank, every signed dot product and the high carry.
+inline packed_parameters admit_centered(uint32_t base, unsigned length, unsigned pack,
+                                        const std::vector<uint32_t> &primes, bool q44) {
+    require(!(base & 1) && base >= 500000000 && base <= 525000000 && length == 32768 && pack == 4,
+            "Unsupported centered GFN-17 base or transform");
+    require(primes.size() == 8 || primes.size() == 9, "Centered field count");
+    packed_parameters a;
+    a.fields = unsigned(primes.size());
+    a.ratio = 1;
+    a.radix = power(base, pack);
+    a.modulus = 1;
+    rational rank_error = 0;
+    integer sum_t = 0;
+    for (uint32_t p : primes) {
+        require(p > base + 2 && p < (1u << 31) && (p - 1) % (2 * length) == 0, "Centered prime range");
+        a.primes.emplace_back(p);
+        a.modulus *= p;
+        rank_error += fraction((integer(1) << 31) - p, integer(1) << 32);
+        sum_t += p / 2;
+    }
+    const integer digit = q44 ? integer((51 * a.radix + 99) / 100) : integer(a.radix / 2 + 1);
+    const integer coefficient = 2 * integer(length) * digit * digit;
+    require(fraction(coefficient, a.modulus) + rank_error < fraction(1, 2), "Centered CRT rank");
+    const integer rank = (a.fields + 1) / 2;
+    if (q44) {
+        const rational eps = fraction(sum_t + rank, integer(1) << 45) + fraction(a.fields + 1, 4096);
+        const integer qmax = sum_t + rank + 1, tmax = coefficient / (a.radix * a.radix) + 3;
+        require(qmax < (integer(1) << 34) && tmax < (integer(1) << 31), "Q44 quotient bounds");
+        require((fraction(1, 2) + 2 * eps) * a.radix + qmax + tmax + 1 < rational(digit),
+                "Q44 centered digit invariant");
+    }
+    require((sum_t + rank + 2) * base < (integer(1) << 63) - base, "Centered signed limb sum");
+    require(coefficient / (a.radix * a.radix) + 2 < base / 2, "Centered carry range");
+    for (const integer &p : a.primes) {
+        a.cofactors.push_back(a.modulus / p);
+        a.inverses.push_back(inverse(a.cofactors.back(), p));
+    }
+    return a;
+}
