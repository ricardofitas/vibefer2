+// Propagate an incoming signed carry through three normalized base-b digits.
+// For large GFN-17 bases the quotient shrinks enough to simplify two divisions.
+INLINE int3 carry_three(long *carry, const int3 digits, const uint b,
+                        const uint inverse, const int shift)
+{
+    long f = *carry + digits.s0;
+    int3 result;
+    result.s0 = reduce64(&f, b, inverse, shift);
+    f += digits.s1;
+#if LN_SZ == 17 && !defined(BALANCED_REMAINDER)
+    if (b >= (1u << 28)) {
+        // |f| <= floor(2^63/b) + b + 2 < 2^29*b: one Barrett step suffices.
+        uint quotient;
+        const uint remainder = barrett(abs(f), b, inverse, shift, &quotient);
+        result.s1 = f < 0 ? -(int)remainder : (int)remainder;
+        f = (f < 0 ? -(long)quotient : (long)quotient) + digits.s2;
+        // Now |f| < 2*b. Truncating division has quotient -1, 0, or 1.
+        const int unit = (f >= (long)b) - (f <= -(long)b);
+        result.s2 = (int)(f - (long)unit * b);
+        *carry = unit;
+        return result;
+    }
+#endif
+    result.s1 = reduce64(&f, b, inverse, shift);
+    f += digits.s2;
+    result.s2 = reduce64(&f, b, inverse, shift);
+    *carry = f;
+    return result;
+}
